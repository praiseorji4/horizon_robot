      <mass value="0.06100178879167756" />
      <inertia ixx="4.8e-05" iyy="6e-06" izz="4.5e-05" ixy="0.0" iyz="0.0" ixz="0.0" />
    </inertial>
    <visual>
      <origin xyz="-0.222 -0.0 -0.084" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find horizon_description)/meshes/oakd_link_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver" />
    </visual>
    <collision>
      <origin xyz="-0.222 -0.0 -0.084" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find horizon_description)/meshes/oakd_link_1.stl" scale="0.001 0.001 0.001" />
