  </link>

  <joint name="oakd_joint" type="fixed">
    <origin xyz="0.222 0.0 0.084" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="oakd_link" />
  </joint>
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.214225 0.0 0.040861" rpy="0 0 0" />
