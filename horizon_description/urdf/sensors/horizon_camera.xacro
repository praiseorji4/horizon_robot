  <link name="camera_link">
    <inertial>
      <origin xyz="-0.003013781377897262 -2.318277353570963e-18 0.003516460553155819" rpy="0 0 0" />
      <mass value="0.003" />
      <inertia ixx="0.0" iyy="0.0" izz="0.0" ixy="0.0" iyz="0.0" ixz="-0.0" />
