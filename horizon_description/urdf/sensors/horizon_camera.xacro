<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="picam_link">
    <inertial>
      <origin xyz="-0.003013781377897262 -2.318277353570963e-18 0.003516460553155819" rpy="0 0 0" />
      <mass value="0.003" />
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6" />
    </inertial>
    <visual>
      <origin xyz="-0.214225 -0.0 -0.040861" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find horizon_description)/meshes/camera_link_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver" />
    </visual>
    <collision>
      <origin xyz="-0.214225 -0.0 -0.040861" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find horizon_description)/meshes/camera_link_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <joint name="base_picam_joint" type="fixed">
    <origin xyz="0.214225 0.0 0.040861" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="picam_link" />
  </joint>

  <!--FRame to help aligin the sensor point to match the hardware (cam is angled 30 degrees downward)-->
  <link name="picam_frame" />
  <joint name="picam_frame_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 ${pi/6} 0" />
    <parent link="picam_link" />
    <child link="picam_frame" />
  </joint>

  <link name="picam_optical_frame" />
  <joint name="picam_optical_frame_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
    <parent link="picam_frame" />
    <child link="picam_optical_frame" />
  </joint>

  <!--Depth Cam-->
  <link name="oakd_link">
    <inertial>
      <origin xyz="-0.008325616440255229 0.00019289755549413884 0.00010124999004827717" rpy="0 0 0" />
      <mass value="0.06100178879167756" />
      <inertia ixx="4.8e-05" iyy="6e-06" izz="4.5e-05" ixy="0.0" iyz="0.0" ixz="0.0" />
    </inertial>
    <visual>
      <origin xyz="-0.222 -0.0 -0.084" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find horizon_description)/meshes/oakd_link_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver" />
    </visual>
    <collision>
      <origin xyz="-0.222 -0.0 -0.084" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find horizon_description)/meshes/oakd_link_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <joint name="base_oakd_joint" type="fixed">
    <origin xyz="0.222 0.0 ${0.084 + (reference_radius - wheel_radius)}" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="oakd_link" />
  </joint>


  <link name="oakd_optical_frame"/>
  <joint name="oakd_optical_frame_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
    <parent link="oakd_link"/>
    <child link="oakd_optical_frame"/>
  </joint>

  <!--Gazebo REferences-->
  <!--Picam-->
  <gazebo reference="picam_frame">
    <sensor name="picam" type="camera">
      <frame_id>picam_optical_frame</frame_id>
      <topic>/picam/image_raw</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <camera>
        <camera_info_topic>/picam/camera_info</camera_info_topic>
        <horizontal_fov>1.0856</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>20</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!--DEpth Cam-->
  <gazebo reference="oakd_link">
    <sensor name="oakd" type="rgbd_camera">
      <frame_id>oakd_optical_frame</frame_id>
      <topic>/oakd</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <camera>
        <camera_info_topic>/oakd/camera_info</camera_info_topic>
        <horizontal_fov>1.2566</horizontal_fov>
        <image>
          <width>640</width>
          <height>400</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>15.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.3</near>
            <far>8.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>
</robot>