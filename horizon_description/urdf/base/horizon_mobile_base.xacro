<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">  
  <link name="base_footprint" />

  <link name="base_link">
    <inertial>
      <origin xyz="-0.0003553128255081884 -0.01259515577682061 0.04627232782888175" rpy="0 0 0" />
      <mass value="3.9702124117925144" />
      <inertia ixx="0.044619" iyy="0.066132" izz="0.098089" ixy="-0.000379" iyz="-0.00061" ixz="-0.00129" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find horizon_description)/meshes/base_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find horizon_description)/meshes/base_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>
  
  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0.0425" rpy="0 0 0" />
    <parent link="base_footprint" />
    <child link="base_link" />
  </joint>

</robot>