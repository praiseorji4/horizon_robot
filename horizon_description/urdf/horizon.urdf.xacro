<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="horizon_bot">
  <xacro:arg name="use_arm" default="false"/>
  <xacro:arg name="drive" default="ros2_control"/>
  <xacro:arg name="wheel" default="mecanum" />
  <xacro:arg name="controller" default="mecanum" />
  <xacro:arg name="controllers_file" default=""/>
  <xacro:arg name="ground_truth" default="false"/>



  <!--Turning args to property to allow for robotness -->
  <xacro:property name="drive" value="$(arg drive)" />
  <xacro:property name="wheel" value="$(arg wheel)"/>
  <xacro:property name="wheel_check" value="${xacro.fatal('FATAL: wheel must be mecanum or plain. Received: ' + wheel) if wheel not in ['mecanum', 'plain'] else ''}" lazy_eval="false"/>
  <xacro:property name="controller" value="$(arg controller)"/>
  <xacro:property name="ground_truth" value="$(arg ground_truth)"/>

  <!--Setting this here since base needs it-->
  <!--Setting wheel separation and radius from the same yaml file-->
  <xacro:property name="wheel_config" value="${xacro.load_yaml('$(find horizon_description)/config/wheels/' + wheel + '.yaml')}" lazy_eval="false"/>
  <xacro:property name="wheel_separation" value="${wheel_config['diff_drive_controller']['ros__parameters']['wheel_separation']}"/> 
  <xacro:property name="wheel_radius" value="${wheel_config['diff_drive_controller']['ros__parameters']['wheel_radius']}"/> 
  <xacro:property name="wheel_width" value="${wheel_config['wheel_params']['ros__parameters']['wheel_width']}"/> 
  <xacro:property name="wheel_mass" value="${wheel_config['wheel_params']['ros__parameters']['wheel_mass']}"/> 

  <!--For Reference Radius-->
  <xacro:property name="mecanum_wheel_config" value="${xacro.load_yaml('$(find horizon_description)/config/wheels/mecanum.yaml')}" lazy_eval="false"/>
  <xacro:property name="reference_radius" value="${mecanum_wheel_config['diff_drive_controller']['ros__parameters']['wheel_radius']}"/> 


  <!--Include Files-->
  <xacro:include filename="$(find horizon_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find horizon_description)/urdf/base/horizon_mobile_base.xacro" />
  <xacro:include filename="$(find horizon_description)/urdf/wheels/horizon_wheels.xacro" />
  <xacro:include filename="$(find horizon_description)/urdf/sensors/horizon_camera.xacro" />
  <xacro:include filename="$(find horizon_description)/urdf/sensors/horizon_imu.xacro" />
  <xacro:include filename="$(find horizon_description)/urdf/sensors/horizon_lidar.xacro" />
  <xacro:include filename="$(find horizon_description)/urdf/gazebo/horizon_mobile_base.gazebo.xacro" />

  <!--Arm Option-->
  <xacro:if value="$(arg use_arm)">
    <xacro:include filename="$(find horizon_description)/urdf/arm/horizon_arm.xacro" />
  </xacro:if>

  <!--Ros_Control Option-->
  <xacro:if value="${drive == 'ros2_control'}">
    <xacro:include filename="$(find horizon_description)/urdf/ros2_control/horizon_ros2_control.xacro"/>
  </xacro:if>

</robot>