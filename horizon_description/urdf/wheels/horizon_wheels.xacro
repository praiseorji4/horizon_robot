<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="wheel_radius" value="0.0425"/>
  <xacro:property name="wheel_length" value="0.04"/>

  <link name="front_left_wheel_link">
    <inertial>
      <origin xyz="2.551340563816673e-08 0.0006253320539596485 -2.5586387187433253e-08" rpy="0 0 0" />
      <mass value="0.1499770678573329" />
      <inertia ixx="8.9e-05" iyy="0.000154" izz="8.9e-05" ixy="0.0" iyz="-0.0" ixz="-0.0" />
    </inertial>
    <visual>
      <origin xyz="-0.16 -0.155 -0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find horizon_description)/meshes/wheel_fl_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length}" />
      </geometry>
    </collision>
  </link>

  <joint name="base_front_left_wheel_joint" type="continuous">
    <origin xyz="0.16 0.155 0.0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="front_left_wheel_link" />
    <axis xyz="0.0 1.0 0.0" />
  </joint>

  <link name="front_right_wheel_link">
    <inertial>
      <origin xyz="3.843054245944444e-07 -0.0006779279390359827 4.2984566024185415e-07" rpy="0 0 0" />
      <mass value="0.14997665166087926" />
      <inertia ixx="8.9e-05" iyy="0.000154" izz="8.9e-05" ixy="-0.0" iyz="-0.0" ixz="0.0" />
    </inertial>
    <visual>
      <origin xyz="-0.16 0.155 -0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find horizon_description)/meshes/wheel_fr_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0" />
      <geometry>
        <cylinder radius="0.0425" length="0.04" />
      </geometry>
    </collision>
  </link>

  <joint name="base_front_right_wheel_joint" type="continuous">
    <origin xyz="0.16 -0.155 0.0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="front_right_wheel_link" />
    <axis xyz="0.0 1.0 0.0" />
  </joint>


  <link name="rear_left_wheel_link">
    <inertial>
      <origin xyz="-3.837284490715298e-07 0.0006779393073299 4.3892931182474334e-07" rpy="0 0 0" />
      <mass value="0.14997663134221842" />
      <inertia ixx="8.9e-05" iyy="0.000154" izz="8.9e-05" ixy="-0.0" iyz="0.0" ixz="-0.0" />
    </inertial>
    <visual>
      <origin xyz="0.16 -0.155 -0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find horizon_description)/meshes/wheel_rl_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0" />
      <geometry>
        <cylinder radius="0.0425" length="0.04" />
      </geometry>
    </collision>
  </link>

  <joint name="base_rear_left_wheel_joint" type="continuous">
    <origin xyz="-0.16 0.155 0.0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rear_left_wheel_link" />
    <axis xyz="0.0 1.0 0.0" />
  </joint>


  <link name="rear_right_wheel_link">
    <inertial>
      <origin xyz="-2.191829839848225e-08 -0.0006253329985821676 -3.474211290147678e-08" rpy="0 0 0" />
      <mass value="0.14997705143711756" />
      <inertia ixx="8.9e-05" iyy="0.000154" izz="8.9e-05" ixy="0.0" iyz="0.0" ixz="-0.0" />
    </inertial>
    <visual>
      <origin xyz="0.16 0.155 -0.0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find horizon_description)/meshes/wheel_rr_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="silver" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0" />
      <geometry>
        <cylinder radius="0.0425" length="0.04" />
      </geometry>
    </collision>
  </link>

  <joint name="base_rear_right_wheel_joint" type="continuous">
    <origin xyz="-0.16 -0.155 0.0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rear_right_wheel_link" />
    <axis xyz="0.0 1.0 0.0" />
  </joint>
</robot>